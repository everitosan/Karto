# Umami (self-hosted). Prefijo PUBLIC_ para que Astro las exponga al cliente.
# Si falta PUBLIC_UMAMI_SRC o PUBLIC_UMAMI_WEBSITE_ID, no se inyecta analítica.
PUBLIC_UMAMI_SRC=https://umami.tudominio/script.js
# Grabador de sesión (opcional): déjalo vacío para desactivarlo.
PUBLIC_UMAMI_RECORDER_SRC=https://umami.tudominio/recorder.js
PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
