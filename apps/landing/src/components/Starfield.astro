---
// Campo de estrellas fijo: 3 capas de densidad/opacidad con twinkle y dos
// estrellas fugaces periódicas. Todo CSS; prefers-reduced-motion lo apaga.
---

<div class="starfield" aria-hidden="true">
  <div class="stars"></div>
  <div class="meteor meteor-a"></div>
  <div class="meteor meteor-b"></div>
</div>

<style>
  .starfield {
    position: fixed;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }

  .stars,
  .stars::before,
  .stars::after {
    content: "";
    position: absolute;
    inset: 0;
    background-repeat: repeat;
    background-size: 640px 640px;
  }
  .stars {
    background-image:
      radial-gradient(1px 1px at 40px 60px, rgba(230, 234, 240, 0.9) 50%, transparent 51%),
      radial-gradient(1px 1px at 210px 140px, rgba(230, 234, 240, 0.7) 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 360px 40px, rgba(230, 234, 240, 0.85) 50%, transparent 51%),
      radial-gradient(1px 1px at 520px 320px, rgba(230, 234, 240, 0.6) 50%, transparent 51%),
      radial-gradient(1px 1px at 120px 420px, rgba(230, 234, 240, 0.8) 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 470px 540px, rgba(230, 234, 240, 0.75) 50%, transparent 51%);
    animation: twinkle 6s ease-in-out infinite alternate;
  }
  .stars::before {
    background-image:
      radial-gradient(1px 1px at 90px 250px, rgba(230, 234, 240, 0.4) 50%, transparent 51%),
      radial-gradient(1px 1px at 300px 480px, rgba(230, 234, 240, 0.35) 50%, transparent 51%),
      radial-gradient(1px 1px at 560px 160px, rgba(230, 234, 240, 0.45) 50%, transparent 51%),
      radial-gradient(1px 1px at 180px 590px, rgba(230, 234, 240, 0.3) 50%, transparent 51%);
    animation: twinkle 9s ease-in-out infinite alternate-reverse;
  }
  .stars::after {
    background-image:
      radial-gradient(2px 2px at 420px 230px, rgba(17, 178, 69, 0.5) 50%, transparent 51%),
      radial-gradient(1px 1px at 60px 520px, rgba(230, 234, 240, 0.25) 50%, transparent 51%);
    animation: twinkle 12s ease-in-out infinite alternate;
  }
  @keyframes twinkle {
    from { opacity: 1; }
    to { opacity: 0.45; }
  }

  /* Estrellas fugaces: trazo diagonal con cola, en ciclos largos para que
     sorprendan en vez de distraer. */
  .meteor {
    position: absolute;
    top: -5%;
    width: 2px;
    height: 2px;
    border-radius: 99px;
    background: rgba(230, 234, 240, 0.9);
    box-shadow: 0 0 6px 1px rgba(230, 234, 240, 0.5);
    opacity: 0;
    rotate: 35deg;
  }
  .meteor::before {
    content: "";
    position: absolute;
    bottom: 1px;
    left: 50%;
    width: 1px;
    height: 90px;
    background: linear-gradient(to top, rgba(230, 234, 240, 0.7), transparent);
  }
  .meteor-a {
    left: 70%;
    animation: shoot 14s linear infinite;
    animation-delay: 3s;
  }
  .meteor-b {
    left: 25%;
    animation: shoot 23s linear infinite;
    animation-delay: 11s;
  }
  @keyframes shoot {
    0% { transform: translate(0, 0); opacity: 0; }
    1% { opacity: 1; }
    6% { transform: translate(-24vmin, 34vmin); opacity: 1; }
    7% { transform: translate(-28vmin, 40vmin); opacity: 0; }
    100% { transform: translate(-28vmin, 40vmin); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .stars,
    .stars::before,
    .stars::after,
    .meteor {
      animation: none;
    }
    .meteor {
      display: none;
    }
  }
</style>
