---
import "@karto/ui/styles.css";
import { Button, Logo, Icon, icons } from "@karto/ui";

const features = [
  { icon: icons.diagram, title: "Mapea tu red", body: "Diagrama servidores, routers, bases de datos y firewalls en un canvas." },
  { icon: icons.lock, title: "Cifrado real", body: "Todo vive en un vault SQLite cifrado con SQLCipher y tu contraseña maestra." },
  { icon: icons.connect, title: "Doble click y dentro", body: "Conéctate por SSH, VNC o RDP sin teclear credenciales." },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Karto — Mapea tu infraestructura</title>
  </head>
  <body>
    <main>
      <section class="hero">
        <Logo client:load variant="full" size={72} />
        <p>Mapea tu infraestructura. Conéctate con un doble click.</p>
        <Button client:load variant="primary">Descargar</Button>
      </section>
      <section class="features">
        {features.map((f) => (
          <article>
            <div class="icon"><Icon client:visible icon={f.icon} size={28} color="var(--karto-color-accent)" /></div>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))}
      </section>
    </main>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        font-family: var(--karto-font-body);
        background: var(--karto-bg);
        background-attachment: fixed;
        color: var(--karto-color-text);
      }
      main { max-width: 60rem; margin: 0 auto; padding: 4rem 1.5rem; }
      .hero { display: flex; flex-direction: column; align-items: center; gap: 1.25rem; text-align: center; padding: 3rem 0; }
      .hero p { opacity: 0.75; font-size: 1.25rem; margin: 0; font-family: var(--karto-font-body); }
      .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1.5rem; margin-top: 3rem; }
      article { background: var(--karto-color-surface); border: 1px solid var(--karto-color-border); padding: 1.5rem; border-radius: 1rem; }
      article h3 { font-family: var(--karto-font-title); font-weight: 600; margin: 0.5rem 0; }
      article p { font-family: var(--karto-font-body); color: var(--karto-color-text-muted); margin: 0; }
      .icon { color: var(--karto-color-accent); line-height: 0; margin-bottom: 0.25rem; }
    </style>
  </body>
</html>
