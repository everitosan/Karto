{
  "name": "karto",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check": "turbo run check",
    "test": "turbo run test",
    "desktop": "turbo run dev --filter=@karto/desktop",
    "storybook": "turbo run dev --filter=@karto/storybook",
    "landing": "turbo run dev --filter=@karto/landing"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.6.3"
  }
}
